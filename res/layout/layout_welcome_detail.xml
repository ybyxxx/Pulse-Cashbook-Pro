<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="14dp">

    <!-- 状态行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_wd_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_red"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/chip_red_text"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="剩余 45 天" />

        <TextView
            android:id="@+id/tv_wd_window"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            tools:text="11-01 ~ 12-30" />
    </LinearLayout>

    <!-- 大数字 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="预计迎新奖赏"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_wd_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/hsbc_red"
        android:textSize="34sp"
        android:textStyle="bold"
        tools:text="$300 / $1,080" />

    <!-- 基础迎新 -->
    <LinearLayout
        android:id="@+id/card_wd_base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_wd_base_mark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/text_hint"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基础迎新"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="累计签账满 8,000 → $800"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_wd_base_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                tools:text="¥5,200 / ¥8,000" />

            <ProgressBar
                android:id="@+id/progress_wd_base"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="8000"
                android:progress="0"
                android:progressTint="@color/hsbc_red"
                android:progressBackgroundTint="#E8E8E8" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_wd_base_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hint"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="$800" />
    </LinearLayout>

    <!-- 额外加码 -->
    <LinearLayout
        android:id="@+id/card_wd_bonus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_wd_bonus_mark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="○"
            android:textColor="@color/text_hint"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="额外加码（叠加）"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="云闪付二维码单笔满 50 → 每次 $10"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_wd_bonus_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                tools:text="4 / 28 次 · $40 / $280" />

            <ProgressBar
                android:id="@+id/progress_wd_bonus"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="28"
                android:progress="0"
                android:progressTint="@color/hsbc_red"
                android:progressBackgroundTint="#E8E8E8" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_wd_bonus_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hint"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="$40" />
    </LinearLayout>

    <!-- 规则脚注 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="支付宝 / 微信不计入迎新签账 · 跳转云闪付需自行确认 · 退款按净额扣减 · 上限 $1,080"
        android:textColor="@color/text_hint"
        android:textSize="10.5sp"
        android:lineSpacingExtra="2dp" />
</LinearLayout>
